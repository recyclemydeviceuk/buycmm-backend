{
  "name": "buyupon-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BuyUpon API: storefront (/api/buy) and admin (/api/buy/admin) endpoints for the CashMyMobile buy side.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed.ts",
    "db:wipe": "tsx src/scripts/wipe.ts",
    "migrate:colours": "tsx src/scripts/migrate-colours.ts",
    "seed:colours": "tsx src/scripts/seed-colours.ts",
    "stock:import": "tsx src/scripts/import-stock.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "typescript": "^5.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
