# ── Server ────────────────────────────────────────────────────────────────────
PORT=8010
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed to call the API (storefront + admin). "*" allows all.
CORS_ORIGIN=http://localhost:3003,http://localhost:3004
STOREFRONT_URL=http://localhost:3003
ADMIN_URL=http://localhost:3004

# ── Database (same Atlas cluster as the sell site, separate database) ─────────
MONGODB_URI=
# Buy-side data lives here. Never set this to the sell database ("test").
BUY_DB_NAME=buyupon
# Read-only: the sell database, used by the seed to copy device image URLs.
SELL_DB_NAME=test

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=7d
OTP_EXPIRY_MINUTES=10
# Comma-separated emails seeded as Owner admins by `npm run seed`.
BUY_ADMIN_EMAILS=

# ── Email (Brevo transactional API) ───────────────────────────────────────────
BREVO_API_KEY=
FROM_EMAIL_Brevo=info@cashmymobile.co.uk
FROM_NAME_Brevo="Cash My Mobile"
SUPPORT_EMAIL=support@cashmymobile.co.uk
# Where new-order / enquiry / review notifications go.
ADMIN_NOTIFY_EMAIL=support@cashmymobile.co.uk

# ── PayPal (the only payment method) ──────────────────────────────────────────
# Required for checkout and refunds. Without them the storefront shows payments as unavailable.
# sandbox → developer.paypal.com test app; live → the live app (and switch the storefront's client id with it).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same PayPal app (Webhooks → add https://<api-host>/api/buy/paypal/webhook,
# events PAYMENT.CAPTURE.COMPLETED / DENIED / REFUNDED / REVERSED). Without it webhooks are rejected.
PAYPAL_WEBHOOK_ID=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
